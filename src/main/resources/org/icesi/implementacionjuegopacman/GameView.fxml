<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="org.icesi.implementacionjuegopacman.Controllers.GameViewController"
           prefWidth="800" prefHeight="600">

    <!-- Imagen de fondo -->
    <ImageView fx:id="menuImage"
               fitWidth="800" fitHeight="600"
               preserveRatio="false"
               visible="true" />

    <!-- Contenido encima del fondo -->
    <AnchorPane prefWidth="800" prefHeight="600">

        <!-- Botón para iniciar juego -->
        <Button fx:id="startButton" layoutX="20" layoutY="20" text="Iniciar Juego" onAction="#onStartGame"/>

        <!-- Botón para cambiar representación -->
        <Button fx:id="switchGraphButton" layoutX="120" layoutY="20" text="Cambiar Modo" onAction="#onSwitchGraph"/>

        <Button fx:id="exitButton"
                layoutX="230" layoutY="20"
                text="Salir"
                onAction="#onExit"
                visible="false"/>

        <Button fx:id="manualButton"
                layoutX="340" layoutY="20"
                text="Manual de Usuario"
                onAction="#mostrarManual" />


        <!-- Canvas para pintar el laberinto -->
        <Canvas fx:id="gameCanvas" layoutX="20" layoutY="60" width="500" height="500"
                style="-fx-effect: dropshadow(gaussian, cyan, 20, 0.6, 0, 0);
                       -fx-border-color: lime;
                       -fx-border-width: 3;
                       -fx-background-color: black;" />

        <!-- Título del juego -->
        <Label fx:id="titleLabel"
               layoutX="550" layoutY="100"
               text="PAC-MAN"
               style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #FFD700;" />

        <!-- Puntaje -->
        <Label fx:id="scoreLabel"
               layoutX="550" layoutY="150"
               text="Puntaje: 0"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #00FF00;" />

    </AnchorPane>

</StackPane>
